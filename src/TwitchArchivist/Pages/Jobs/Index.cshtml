@page
@using TwitchArchivist.Pages
@model TwitchArchivist.Pages.Jobs.IndexModel
@{
    ViewData["Title"] = "Jobs";
}

<section class="panel">
    <h2>Archive jobs</h2>
    <p class="muted">Showing the 50 most recent jobs.</p>
    @if (Model.Jobs.Count == 0)
    {
        <div class="empty-state">
            <h3>No archive jobs yet</h3>
            <p>Jobs will appear here when a configured channel goes live or a manual archive is triggered.</p>
        </div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Channel</th>
                    <th>Status</th>
                    <th>Trigger</th>
                    <th>Created</th>
                    <th>Error</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var job in Model.Jobs)
            {
                <tr>
                    <td>@job.ChannelConfiguration.TwitchLogin</td>
                    <td><span class="badge @UiBadges.JobStatusBadgeClass(job.Status)">@UiBadges.JobStatusLabel(job.Status)</span></td>
                    <td>@job.TriggerSource</td>
                    <td><span class="mono">@job.CreatedUtc.ToString("u")</span></td>
                    <td>
                        @if (job.LastError is not null)
                        {
                            <span class="mono">@job.LastError</span>
                        }
                        else
                        {
                            @:-
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
