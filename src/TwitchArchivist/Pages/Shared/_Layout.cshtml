@{
    var currentPage = (ViewContext.RouteData.Values["page"] as string ?? string.Empty);
    string NavClass(string pagePath) =>
        currentPage.StartsWith(pagePath, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    var autoRefreshEnabled = ViewData["AutoRefreshEnabled"] as bool? ?? true;
    const int autoRefreshDefaultIntervalSeconds = 120;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TwitchArchivist</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23132238'/%3E%3Cpath d='M14 14h36v22l-8 8h-8l-6 6v-6h-14V14z' fill='%2360a5fa'/%3E%3Crect x='28' y='22' width='4' height='12' fill='%23132238'/%3E%3Crect x='38' y='22' width='4' height='12' fill='%23132238'/%3E%3C/svg%3E" />
    <style>
        :root {
            color-scheme: dark;
            font-family: "Segoe UI", sans-serif;
            --bg: #05080d;
            --bg-elevated: #0b1018;
            --bg-panel: #0a0f17;
            --bg-panel-strong: #0e1420;
            --bg-row: #070a11;
            --border: rgba(148, 163, 184, 0.12);
            --border-strong: rgba(96, 165, 250, 0.22);
            --text: #e5eefb;
            --text-muted: #94a3b8;
            --accent: #60a5fa;
            --accent-strong: #3b82f6;
            --accent-soft: rgba(96, 165, 250, 0.14);
            --success-soft: rgba(34, 197, 94, 0.14);
            --success-text: #86efac;
            --warn-soft: rgba(245, 158, 11, 0.14);
            --warn-text: #fcd34d;
            --danger-soft: rgba(239, 68, 68, 0.14);
            --danger-text: #fca5a5;
            --info-soft: rgba(96, 165, 250, 0.14);
            --info-text: #bfdbfe;
            --neutral-soft: rgba(148, 163, 184, 0.12);
            --neutral-text: #cbd5e1;
            --shadow: 0 18px 50px rgba(0, 0, 0, 0.55);
            --mono-font: ui-monospace, "Cascadia Mono", "Consolas", "SFMono-Regular", "Menlo", monospace;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: var(--bg);
            color: var(--text);
        }

        header {
            background: #070b12;
            color: var(--text);
            padding: 0.85rem 1.5rem 0.95rem;
            border-bottom: 1px solid var(--border);
        }

        .header-row {
            display: flex;
            align-items: center;
            gap: 1.25rem;
            flex-wrap: wrap;
        }

        header h1 {
            margin: 0;
            font-size: 1.25rem;
            letter-spacing: 0.01em;
            flex: 0 0 auto;
        }

        nav {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
        }

        .header-tools {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .header-tool {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            color: var(--text-muted);
            font-size: 0.88rem;
            font-weight: 600;
        }

        .header-tool input[type=checkbox] {
            width: auto;
            margin: 0;
            accent-color: var(--accent);
        }

        .header-tool select {
            width: auto;
            min-width: 7rem;
            padding: 0.35rem 0.55rem;
            font-size: 0.88rem;
        }

        nav a {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            display: inline-block;
            padding: 0.35rem 0.75rem;
            border-radius: 0.4rem;
            background: transparent;
            border: 1px solid transparent;
            transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
        }

        nav a:hover {
            background: rgba(255, 255, 255, 0.04);
            color: var(--text);
        }

        nav a.active {
            background: rgba(96, 165, 250, 0.10);
            border-color: var(--border-strong);
            color: var(--info-text);
        }

        main {
            max-width: 1100px;
            margin: 0 auto;
            padding: 1.5rem 1.5rem 2rem;
        }

        .panel {
            background: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: 0.85rem;
            padding: 1rem 1.25rem;
            box-shadow: 0 1px 0 rgba(255, 255, 255, 0.02) inset, 0 8px 24px rgba(0, 0, 0, 0.45);
            margin-bottom: 1rem;
        }

        h1, h2, h3 {
            color: #f8fbff;
        }

        a {
            color: #93c5fd;
        }

        a:hover {
            color: #bfdbfe;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: var(--bg-row);
            border-radius: 0.6rem;
            overflow: hidden;
            border: 1px solid var(--border);
        }

        th, td {
            text-align: left;
            padding: 0.65rem 0.65rem;
            border-bottom: 1px solid var(--border);
            vertical-align: top;
        }

        tbody tr:last-child td {
            border-bottom: 0;
        }

        tbody tr:nth-child(even) td {
            background: rgba(255, 255, 255, 0.015);
        }

        th {
            color: var(--text-muted);
            font-size: 0.82rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            background: #0c121b;
            border-bottom: 1px solid var(--border);
        }

        .grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        }

        .metric {
            font-size: 1.75rem;
            font-weight: 700;
            margin-top: 0.5rem;
            color: #f8fbff;
        }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 0.25rem;
            color: #dbe7f5;
        }

        input[type=text], input[type=password], input[type=number] {
            width: 100%;
            padding: 0.65rem 0.75rem;
            border-radius: 0.5rem;
            border: 1px solid var(--border-strong);
            box-sizing: border-box;
            background: #0d131c;
            color: var(--text);
        }

        input[type=text]:focus, input[type=password]:focus, input[type=number]:focus {
            outline: 2px solid rgba(96, 165, 250, 0.35);
            outline-offset: 1px;
            border-color: rgba(147, 197, 253, 0.45);
        }

        select {
            width: 100%;
            padding: 0.65rem 0.75rem;
            border-radius: 0.5rem;
            border: 1px solid var(--border-strong);
            box-sizing: border-box;
            background: #0d131c;
            color: var(--text);
        }

        .form-grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        }

        .input-with-button {
            display: flex;
            gap: 0.6rem;
            align-items: stretch;
        }

        .input-with-button input[type=text] {
            flex: 1 1 auto;
        }

        .input-with-button .button-ghost {
            flex: 0 0 auto;
            white-space: nowrap;
        }

        .field-hint {
            margin: 0.35rem 0 0;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .actions {
            margin-top: 1rem;
            display: flex;
            gap: 0.75rem;
        }

        .toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: end;
            justify-content: space-between;
            margin: 1rem 0 0.75rem;
        }

        .toolbar-group {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            align-items: end;
        }

        .panel-header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        button, .button-link {
            background: var(--accent-strong);
            color: white;
            border: 0;
            border-radius: 0.4rem;
            padding: 0.55rem 0.95rem;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            font-weight: 600;
            box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06) inset;
        }

        button:hover, .button-link:hover {
            background: var(--accent);
            color: white;
        }

        .button-ghost {
            background: transparent;
            color: #bfdbfe;
            border: 1px solid var(--border-strong);
            border-radius: 0.4rem;
            padding: 0.35rem 0.7rem;
            font-weight: 600;
            font-size: 0.88rem;
            box-shadow: none;
            text-decoration: none;
            display: inline-block;
            cursor: pointer;
        }

        .button-ghost:hover {
            background: var(--accent-soft);
            border-color: rgba(147, 197, 253, 0.45);
            color: white;
        }

        .button-danger {
            background: #991b1b;
            box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04) inset;
        }

        .button-danger:hover {
            background: #b91c1c;
        }

        .muted {
            color: var(--text-muted);
        }

        .mono {
            font-family: var(--mono-font);
            font-size: 0.92em;
        }

        .diagnostics-message {
            margin: 0;
            white-space: pre-wrap;
            word-break: break-word;
            line-height: 1.5;
        }

        .badge {
            display: inline-block;
            border-radius: 999px;
            padding: 0.2rem 0.6rem;
            font-size: 0.85rem;
            font-weight: 600;
            background: var(--success-soft);
            color: var(--success-text);
            border: 1px solid rgba(34, 197, 94, 0.18);
        }

        .badge.success {
            background: var(--success-soft);
            color: var(--success-text);
            border: 1px solid rgba(34, 197, 94, 0.18);
        }

        .badge.warn {
            background: var(--warn-soft);
            color: var(--warn-text);
            border: 1px solid rgba(245, 158, 11, 0.18);
        }

        .badge.danger {
            background: var(--danger-soft);
            color: var(--danger-text);
            border: 1px solid rgba(239, 68, 68, 0.2);
        }

        .badge.info {
            background: var(--info-soft);
            color: var(--info-text);
            border: 1px solid rgba(96, 165, 250, 0.22);
        }

        .badge.neutral {
            background: var(--neutral-soft);
            color: var(--neutral-text);
            border: 1px solid rgba(148, 163, 184, 0.22);
        }

        .level-pill {
            display: inline-block;
            border-radius: 0.25rem;
            padding: 0.05rem 0.4rem;
            font-family: var(--mono-font);
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        .level-pill.level-trace { background: transparent; color: #94a3b8; border: 1px solid var(--border); }
        .level-pill.level-debug { background: transparent; color: #cbd5e1; border: 1px solid var(--border); }
        .level-pill.level-information { background: transparent; color: var(--info-text); border: 1px solid rgba(96, 165, 250, 0.35); }
        .level-pill.level-warning { background: transparent; color: var(--warn-text); border: 1px solid rgba(245, 158, 11, 0.35); }
        .level-pill.level-error { background: rgba(239, 68, 68, 0.10); color: var(--danger-text); border: 1px solid rgba(239, 68, 68, 0.4); }
        .level-pill.level-critical { background: rgba(239, 68, 68, 0.22); color: #fee2e2; border: 1px solid rgba(239, 68, 68, 0.55); }

        .validation-summary-errors {
            color: var(--danger-text);
            margin-bottom: 1rem;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 1.1rem;
        }

        .field-validation-error {
            color: var(--danger-text);
            font-size: 0.85rem;
        }

        .field-hint.error {
            color: var(--danger-text);
        }

        .portal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(3, 7, 18, 0.74);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            z-index: 1100;
        }

        .portal-backdrop[hidden] {
            display: none;
        }

        .portal-dialog {
            width: min(720px, 100%);
            max-height: min(82vh, 860px);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            border-radius: 0.9rem;
            background: var(--bg-panel-strong);
            border: 1px solid var(--border-strong);
            box-shadow: var(--shadow);
        }

        .portal-header,
        .portal-footer {
            padding: 0.9rem 1rem;
            border-bottom: 1px solid var(--border);
        }

        .portal-footer {
            border-bottom: 0;
            border-top: 1px solid var(--border);
            display: flex;
            gap: 0.75rem;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .portal-body {
            padding: 1rem;
            min-height: 0;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            gap: 0.9rem;
        }

        .portal-toolbar {
            display: flex;
            gap: 0.6rem;
            flex-wrap: wrap;
            align-items: center;
        }

        .portal-path {
            padding: 0.65rem 0.75rem;
            border-radius: 0.5rem;
            background: var(--bg-row);
            border: 1px solid var(--border);
            font-family: var(--mono-font);
            word-break: break-all;
        }

        .portal-list {
            list-style: none;
            margin: 0;
            padding: 0;
            min-height: 0;
            flex: 1 1 auto;
            overflow: auto;
            border-radius: 0.65rem;
            border: 1px solid var(--border);
            background: var(--bg-row);
        }

        .portal-list[hidden] {
            display: none;
        }

        .portal-list li + li {
            border-top: 1px solid var(--border);
        }

        .portal-row {
            width: 100%;
            border: 0;
            background: transparent;
            color: var(--text);
            text-align: left;
            padding: 0.75rem 0.85rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
        }

        .portal-row:hover,
        .portal-row:focus {
            background: rgba(96, 165, 250, 0.12);
            outline: none;
        }

        .portal-empty {
            margin: 0;
            color: var(--text-muted);
        }

        .autocomplete-list {
            list-style: none;
            margin: 0.45rem 0 0;
            padding: 0;
            border-radius: 0.6rem;
            border: 1px solid var(--border);
            background: #09101a;
            overflow: hidden;
        }

        .autocomplete-list[hidden] {
            display: none;
        }

        .autocomplete-list li + li {
            border-top: 1px solid var(--border);
        }

        .autocomplete-option {
            width: 100%;
            border: 0;
            background: transparent;
            color: var(--text);
            text-align: left;
            padding: 0.65rem 0.8rem;
            cursor: pointer;
        }

        .autocomplete-option:hover,
        .autocomplete-option:focus {
            background: rgba(96, 165, 250, 0.12);
            outline: none;
        }

        .autocomplete-primary {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            font-weight: 600;
        }

        .autocomplete-secondary {
            margin-top: 0.18rem;
            font-size: 0.82rem;
            color: var(--text-muted);
        }

        .log-text {
            margin: 0;
            white-space: pre-wrap;
            word-break: break-word;
            font: inherit;
        }

        .log-feed {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            margin-top: 0.75rem;
        }

        .log-entry {
            background: var(--bg-row);
            border: 1px solid var(--border);
            border-left: 3px solid var(--border);
            border-radius: 0.35rem;
            padding: 0.55rem 0.75rem 0.6rem;
        }

        .log-entry.level-information { border-left-color: rgba(96, 165, 250, 0.55); }
        .log-entry.level-warning { border-left-color: var(--warn-text); }
        .log-entry.level-error { border-left-color: var(--danger-text); }
        .log-entry.level-critical { border-left-color: #fee2e2; background: rgba(239, 68, 68, 0.05); }
        .log-entry.level-debug, .log-entry.level-trace { opacity: 0.85; }

        .log-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 0.55rem;
            align-items: baseline;
            font-size: 0.82rem;
            margin-bottom: 0.3rem;
        }

        .log-meta .log-time {
            color: var(--text-muted);
            font-family: var(--mono-font);
            white-space: nowrap;
        }

        .log-meta .log-cat {
            color: var(--info-text);
            font-family: var(--mono-font);
            word-break: break-all;
            opacity: 0.85;
        }

        .log-message {
            margin: 0;
            color: var(--text);
            white-space: pre-wrap;
            word-break: break-word;
            font-family: var(--mono-font);
            font-size: 0.9rem;
            line-height: 1.45;
        }

        .log-entry details.expandable {
            margin-top: 0.4rem;
            font-size: 0.85rem;
        }

        .log-entry details.expandable > summary {
            color: var(--text-muted);
        }

        .log-entry details.expandable[open] > summary {
            color: var(--danger-text);
        }

        .log-entry details.expandable pre {
            margin: 0.35rem 0 0;
            padding: 0.5rem 0.65rem;
            background: rgba(0, 0, 0, 0.35);
            border-radius: 0.35rem;
            border: 1px solid var(--border);
            font-family: var(--mono-font);
            font-size: 0.82rem;
            color: var(--danger-text);
        }

        details.expandable {
            cursor: pointer;
        }

        details.expandable > summary {
            list-style: none;
            color: #93c5fd;
            font-weight: 600;
        }

        details.expandable > summary::-webkit-details-marker {
            display: none;
        }

        details.expandable[open] > summary {
            margin-bottom: 0.4rem;
        }

        .kv-card {
            display: grid;
            grid-template-columns: minmax(11rem, max-content) 1fr;
            gap: 0.4rem 1rem;
            font-size: 0.95rem;
        }

        .kv-card dt {
            color: var(--text-muted);
            font-weight: 600;
            padding-top: 0.05rem;
        }

        .kv-card dd {
            margin: 0;
            color: var(--text);
            word-break: break-word;
        }

        .empty-state {
            text-align: center;
            padding: 1.75rem 1rem 2rem;
            color: var(--text-muted);
        }

        .empty-state h3 {
            margin: 0 0 0.5rem;
            color: var(--text);
        }

        .empty-state p {
            margin: 0 0 1rem;
        }

        .heartbeat {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .heartbeat::before {
            content: "";
            display: inline-block;
            width: 0.55rem;
            height: 0.55rem;
            border-radius: 50%;
            background: var(--success-text);
            box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.18);
            animation: heartbeat-pulse 2.4s ease-in-out infinite;
        }

        @@keyframes heartbeat-pulse {
            0%, 100% { opacity: 0.55; transform: scale(0.85); }
            50% { opacity: 1; transform: scale(1.05); }
        }

        @@media (max-width: 960px) {
            main { padding: 1.25rem 1rem 1.75rem; }
            .header-row { gap: 0.75rem; }
            .header-tools { margin-left: 0; width: 100%; }
        }

        @@media (max-width: 720px) {
            header { padding: 0.85rem 1rem 0.95rem; }
            nav { width: 100%; }
        }
    </style>
</head>
<body data-auto-refresh-enabled="@autoRefreshEnabled.ToString().ToLowerInvariant()"
      data-auto-refresh-default-interval-seconds="@autoRefreshDefaultIntervalSeconds">
    <header>
        <div class="header-row">
            <h1>Twitch Archivist</h1>
            <nav>
                <a class="@NavClass("/Index")" asp-page="/Index">Dashboard</a>
                <a class="@NavClass("/Channels")" asp-page="/Channels/Index">Channels</a>
                <a class="@NavClass("/Jobs")" asp-page="/Jobs/Index">Jobs</a>
                <a class="@NavClass("/Diagnostics")" asp-page="/Diagnostics/Index">Diagnostics</a>
                <a class="@NavClass("/Logs")" asp-page="/Logs/Index">Logs</a>
            </nav>
            <div class="header-tools">
                <label class="header-tool">
                    <input type="checkbox" data-auto-refresh-toggle="true" />
                    <span>Auto refresh</span>
                </label>
                <label class="header-tool">
                    <span>Interval</span>
                    <select data-auto-refresh-interval="true">
                        <option value="30">30s</option>
                        <option value="60">1m</option>
                        <option value="120">2m</option>
                        <option value="300">5m</option>
                        <option value="900">15m</option>
                    </select>
                </label>
            </div>
        </div>
    </header>
    <main>
        @RenderBody()
    </main>
    <div class="portal-backdrop" data-directory-picker-portal="true" hidden>
        <div class="portal-dialog" role="dialog" aria-modal="true" aria-labelledby="directory-picker-title">
            <div class="portal-header">
                <h3 id="directory-picker-title">Select output folder</h3>
                <p class="field-hint">Browse the server-visible filesystem, or close this dialog and type the path manually.</p>
            </div>
            <div class="portal-body">
                <div class="portal-toolbar">
                    <button type="button" class="button-ghost" data-directory-picker-roots="true">Roots</button>
                    <button type="button" class="button-ghost" data-directory-picker-up="true">Up</button>
                </div>
                <div class="portal-path" data-directory-picker-current-path="true"></div>
                <p class="field-hint error" data-directory-picker-error="true" hidden></p>
                <ul class="portal-list" data-directory-picker-list="true"></ul>
                <p class="portal-empty" data-directory-picker-empty="true" hidden>No subfolders found for this location.</p>
            </div>
            <div class="portal-footer">
                <button type="button" class="button-link" data-directory-picker-choose="true">Use this folder</button>
                <button type="button" class="button-ghost" data-directory-picker-close="true">Close</button>
            </div>
        </div>
    </div>
    <div class="portal-backdrop" data-file-picker-portal="true" hidden>
        <div class="portal-dialog" role="dialog" aria-modal="true" aria-labelledby="file-picker-title">
            <div class="portal-header">
                <h3 id="file-picker-title">Select TwitchDownloaderCLI executable</h3>
                <p class="field-hint">Browse the server-visible filesystem and choose the `TwitchDownloaderCLI.exe` file.</p>
            </div>
            <div class="portal-body">
                <div class="portal-toolbar">
                    <button type="button" class="button-ghost" data-file-picker-roots="true">Roots</button>
                    <button type="button" class="button-ghost" data-file-picker-up="true">Up</button>
                </div>
                <div class="portal-path" data-file-picker-current-path="true"></div>
                <p class="field-hint error" data-file-picker-error="true" hidden></p>
                <ul class="portal-list" data-file-picker-list="true"></ul>
                <p class="portal-empty" data-file-picker-empty="true" hidden>No matching folders or files found for this location.</p>
            </div>
            <div class="portal-footer">
                <span class="field-hint">Click a folder to open it, or click the executable to select it.</span>
                <button type="button" class="button-ghost" data-file-picker-close="true">Close</button>
            </div>
        </div>
    </div>
    <script>
        (() => {
            const setText = (id, value, fallback = "") => {
                const element = document.getElementById(id);
                if (!element) {
                    return;
                }

                element.textContent = value ?? fallback;
            };

            const setBadgeClass = (id, badgeClass) => {
                const element = document.getElementById(id);
                if (!element) {
                    return;
                }

                element.classList.remove("success", "warn", "danger", "info", "neutral");
                if (badgeClass) {
                    element.classList.add(badgeClass);
                }
            };

            const initAutoRefresh = () => {
                const { body } = document;
                if (!body) {
                    return;
                }

                const toggle = document.querySelector("[data-auto-refresh-toggle='true']");
                const intervalSelect = document.querySelector("[data-auto-refresh-interval='true']");
                if (!(toggle instanceof HTMLInputElement) || !(intervalSelect instanceof HTMLSelectElement)) {
                    return;
                }

                const enabledStorageKey = "twitchArchivist.autoRefresh.enabled";
                const intervalStorageKey = "twitchArchivist.autoRefresh.intervalSeconds";
                const defaultIntervalSeconds = Number.parseInt(body.dataset.autoRefreshDefaultIntervalSeconds ?? "120", 10);

                const normalizeInterval = value => {
                    const parsed = Number.parseInt(value ?? "", 10);
                    return Number.isFinite(parsed) && parsed > 0 ? parsed : defaultIntervalSeconds;
                };

                const readEnabled = () => {
                    const persisted = localStorage.getItem("twitchArchivist.autoRefresh.enabled");
                    return persisted === null ? true : persisted === "true";
                };

                const readIntervalSeconds = () =>
                    normalizeInterval(localStorage.getItem("twitchArchivist.autoRefresh.intervalSeconds"));

                const writeEnabled = value => {
                    localStorage.setItem(enabledStorageKey, value ? "true" : "false");
                };

                const writeIntervalSeconds = value => {
                    localStorage.setItem(intervalStorageKey, String(normalizeInterval(value)));
                };

                const isRefreshPaused = () =>
                    body.dataset.autoRefreshEnabled !== "true" ||
                    document.hidden ||
                    document.querySelector("[data-directory-picker-portal='true']:not([hidden])") !== null ||
                    document.querySelector("[data-file-picker-portal='true']:not([hidden])") !== null;

                const applyControlState = () => {
                    const enabled = readEnabled();
                    const intervalSeconds = readIntervalSeconds();
                    toggle.checked = enabled;
                    intervalSelect.value = String(intervalSeconds);
                };

                applyControlState();

                toggle.addEventListener("change", () => {
                    writeEnabled(toggle.checked);
                });

                intervalSelect.addEventListener("change", () => {
                    writeIntervalSeconds(intervalSelect.value);
                    intervalSelect.value = String(readIntervalSeconds());
                });

                let nextRefreshAt = Date.now() + readIntervalSeconds() * 1000;

                window.setInterval(() => {
                    const enabled = readEnabled();
                    const intervalSeconds = readIntervalSeconds();

                    if (!enabled) {
                        nextRefreshAt = Date.now() + intervalSeconds * 1000;
                        return;
                    }

                    if (Date.now() < nextRefreshAt) {
                        return;
                    }

                    if (isRefreshPaused()) {
                        return;
                    }

                    window.location.reload();
                }, 1000);

                window.setInterval(() => {
                    applyControlState();
                }, 5000);
            };

            const eventSubBadgeClass = state => {
                switch (state) {
                    case "connected":
                    case "reconnected":
                        return "success";
                    case "connecting":
                    case "awaiting-authorization":
                        return "warn";
                    case "disconnected":
                    case "error":
                        return "danger";
                    case "not-configured":
                        return "neutral";
                    default:
                        return "neutral";
                }
            };

            const validityBadgeClass = validity => {
                if (validity === "valid") return "success";
                if (validity === "expiring-soon") return "warn";
                return "danger";
            };

            const formatRelative = isoUtc => {
                if (!isoUtc) return "";
                const then = Date.parse(isoUtc);
                if (Number.isNaN(then)) return "";
                const diffSec = Math.max(0, Math.round((Date.now() - then) / 1000));
                if (diffSec < 5) return "just now";
                if (diffSec < 60) return diffSec + "s ago";
                if (diffSec < 3600) return Math.round(diffSec / 60) + "m ago";
                return Math.round(diffSec / 3600) + "h ago";
            };

            let lastUpdatedUtc = null;

            const tickRelative = () => {
                const target = document.getElementById("runtime-relative");
                if (!target) return;
                target.textContent = lastUpdatedUtc ? "Updated " + formatRelative(lastUpdatedUtc) : "";
            };

            const renderRuntimeStatus = payload => {
                const diagnosticsMessage = payload.diagnosticsMessage && payload.diagnosticsMessage.trim().length > 0
                    ? payload.diagnosticsMessage
                    : "—";
                setText("runtime-diagnostics-message", diagnosticsMessage);
                const eventSubState = payload.eventSubConnectionState ?? "";
                setText("runtime-eventsub-state", eventSubState);
                setBadgeClass("runtime-eventsub-state", eventSubBadgeClass(eventSubState));
                setText("runtime-twitch-configured", payload.twitchUserAuthorizationConfigured ? "Configured" : "Missing");
                const validity = payload.twitchUserAuthorizationValidity ?? "missing";
                setText("runtime-twitch-validity", validity);
                setBadgeClass("runtime-twitch-validity", validityBadgeClass(validity));
                setText("runtime-twitch-user", payload.twitchUserAuthorizationLogin ?? "Not authorized");
                setText("runtime-twitch-expires", payload.twitchUserAuthorizationExpiresUtc ?? "Not authorized");
                setText("runtime-twitch-last-validated", payload.twitchUserAuthorizationLastValidatedUtc ?? "Not validated");
                setText("runtime-twitch-detail", payload.twitchUserAuthorizationDetail ?? "");
                setText("runtime-updated-utc", payload.updatedUtc ?? "");
                if (payload.updatedUtc) {
                    lastUpdatedUtc = payload.updatedUtc;
                    tickRelative();
                }
            };

            const refreshRuntimeStatus = async () => {
                try {
                    const response = await fetch("/api/runtime-status", { cache: "no-store" });
                    if (!response.ok) {
                        return;
                    }

                    const payload = await response.json();
                    renderRuntimeStatus(payload);
                } catch {
                }
            };

            if (document.getElementById("runtime-twitch-validity") || document.getElementById("runtime-eventsub-state")) {
                refreshRuntimeStatus();
                window.setInterval(refreshRuntimeStatus, 15000);
                window.setInterval(tickRelative, 5000);
            }

            const initDirectoryPickers = () => {
                const portal = document.querySelector("[data-directory-picker-portal='true']");
                const list = portal?.querySelector("[data-directory-picker-list='true']");
                const rootsButton = portal?.querySelector("[data-directory-picker-roots='true']");
                const upButton = portal?.querySelector("[data-directory-picker-up='true']");
                const closeButton = portal?.querySelector("[data-directory-picker-close='true']");
                const chooseButton = portal?.querySelector("[data-directory-picker-choose='true']");
                const currentPathLabel = portal?.querySelector("[data-directory-picker-current-path='true']");
                const errorLabel = portal?.querySelector("[data-directory-picker-error='true']");
                const emptyLabel = portal?.querySelector("[data-directory-picker-empty='true']");
                if (!(portal instanceof HTMLDivElement) ||
                    !(list instanceof HTMLUListElement) ||
                    !(rootsButton instanceof HTMLButtonElement) ||
                    !(upButton instanceof HTMLButtonElement) ||
                    !(closeButton instanceof HTMLButtonElement) ||
                    !(chooseButton instanceof HTMLButtonElement) ||
                    !(currentPathLabel instanceof HTMLDivElement) ||
                    !(errorLabel instanceof HTMLParagraphElement) ||
                    !(emptyLabel instanceof HTMLParagraphElement)) {
                    return;
                }

                let activeInput = null;
                let currentPath = "";

                const setPortalError = message => {
                    if (!message) {
                        errorLabel.hidden = true;
                        errorLabel.textContent = "";
                        return;
                    }

                    errorLabel.hidden = false;
                    errorLabel.textContent = message;
                };

                const setPortalPath = path => {
                    currentPath = path ?? "";
                    currentPathLabel.textContent = currentPath || "Choose a drive or root folder.";
                };

                const getParentPath = path => {
                    if (!path) {
                        return "";
                    }

                    const normalized = path.replace(/[\\/]+$/, "");
                    const lastSeparatorIndex = Math.max(normalized.lastIndexOf("\\"), normalized.lastIndexOf("/"));
                    if (lastSeparatorIndex < 0) {
                        return "";
                    }

                    const parent = normalized.slice(0, lastSeparatorIndex + 1);
                    if (!parent || parent === path) {
                        return "";
                    }

                    return parent;
                };

                const renderList = paths => {
                    list.innerHTML = "";
                    emptyLabel.hidden = Array.isArray(paths) && paths.length > 0;

                    for (const entry of paths ?? []) {
                        const item = document.createElement("li");
                        const button = document.createElement("button");
                        button.type = "button";
                        button.className = "portal-row";
                        button.innerHTML = `<span class="mono">${entry.path}</span><span>Open</span>`;
                        button.addEventListener("click", () => {
                            loadDirectories(entry.path);
                        });
                        item.appendChild(button);
                        list.appendChild(item);
                    }
                };

                const loadRoots = async () => {
                    setPortalError("");
                    setPortalPath("");
                    list.innerHTML = "";
                    emptyLabel.hidden = true;

                    try {
                        const response = await fetch("/api/filesystem/roots", { cache: "no-store" });
                        if (!response.ok) {
                            setPortalError("Unable to load filesystem roots.");
                            return;
                        }

                        const roots = await response.json();
                        renderList(roots);
                    } catch {
                        setPortalError("Unable to load filesystem roots.");
                    }
                };

                const loadDirectories = async path => {
                    setPortalError("");
                    setPortalPath(path);
                    list.innerHTML = "";
                    emptyLabel.hidden = true;

                    try {
                        const response = await fetch(`/api/filesystem/directories?path=${encodeURIComponent(path)}`, {
                            cache: "no-store"
                        });

                        if (!response.ok) {
                            const payload = await response.json().catch(() => null);
                            setPortalError(payload?.error ?? "Unable to load subfolders.");
                            return;
                        }

                        const directories = await response.json();
                        renderList(directories);
                    } catch {
                        setPortalError("Unable to load subfolders.");
                    }
                };

                const closePortal = () => {
                    portal.hidden = true;
                    activeInput = null;
                    setPortalError("");
                };

                document.querySelectorAll("[data-directory-picker='true']").forEach(input => {
                    const button = input.parentElement?.querySelector("[data-directory-picker-button='true']");
                    const status = input.parentElement?.parentElement?.querySelector("[data-directory-picker-status='true']");
                    if (!(input instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement)) {
                        return;
                    }

                    const setStatus = (message, isError) => {
                        if (!(status instanceof HTMLParagraphElement)) {
                            return;
                        }

                        if (!message) {
                            status.hidden = true;
                            status.textContent = "";
                            status.classList.remove("error");
                            return;
                        }

                        status.hidden = false;
                        status.textContent = message;
                        status.classList.toggle("error", !!isError);
                    };

                    button.addEventListener("click", async () => {
                        setStatus("", false);
                        activeInput = input;
                        portal.hidden = false;

                        const initialPath = input.value.trim();
                        if (initialPath) {
                            await loadDirectories(initialPath);
                        } else {
                            await loadRoots();
                        }
                    });
                });

                rootsButton.addEventListener("click", loadRoots);
                upButton.addEventListener("click", async () => {
                    const parentPath = getParentPath(currentPath);
                    if (parentPath) {
                        await loadDirectories(parentPath);
                        return;
                    }

                    await loadRoots();
                });
                chooseButton.addEventListener("click", () => {
                    if (activeInput && currentPath) {
                        activeInput.value = currentPath;
                    }

                    closePortal();
                });
                closeButton.addEventListener("click", closePortal);
                portal.addEventListener("click", event => {
                    if (event.target === portal) {
                        closePortal();
                    }
                });
            };

            const initFilePickers = () => {
                const portal = document.querySelector("[data-file-picker-portal='true']");
                const list = portal?.querySelector("[data-file-picker-list='true']");
                const rootsButton = portal?.querySelector("[data-file-picker-roots='true']");
                const upButton = portal?.querySelector("[data-file-picker-up='true']");
                const closeButton = portal?.querySelector("[data-file-picker-close='true']");
                const currentPathLabel = portal?.querySelector("[data-file-picker-current-path='true']");
                const errorLabel = portal?.querySelector("[data-file-picker-error='true']");
                const emptyLabel = portal?.querySelector("[data-file-picker-empty='true']");
                if (!(portal instanceof HTMLDivElement) ||
                    !(list instanceof HTMLUListElement) ||
                    !(rootsButton instanceof HTMLButtonElement) ||
                    !(upButton instanceof HTMLButtonElement) ||
                    !(closeButton instanceof HTMLButtonElement) ||
                    !(currentPathLabel instanceof HTMLDivElement) ||
                    !(errorLabel instanceof HTMLParagraphElement) ||
                    !(emptyLabel instanceof HTMLParagraphElement)) {
                    return;
                }

                let activeInput = null;
                let currentPath = "";

                const setPortalError = message => {
                    if (!message) {
                        errorLabel.hidden = true;
                        errorLabel.textContent = "";
                        return;
                    }

                    errorLabel.hidden = false;
                    errorLabel.textContent = message;
                };

                const setPortalPath = path => {
                    currentPath = path ?? "";
                    currentPathLabel.textContent = currentPath || "Choose a drive or root folder.";
                };

                const getParentPath = path => {
                    if (!path) {
                        return "";
                    }

                    const normalized = path.replace(/[\\/]+$/, "");
                    const lastSeparatorIndex = Math.max(normalized.lastIndexOf("\\"), normalized.lastIndexOf("/"));
                    if (lastSeparatorIndex < 0) {
                        return "";
                    }

                    const parent = normalized.slice(0, lastSeparatorIndex + 1);
                    if (!parent || parent === path) {
                        return "";
                    }

                    return parent;
                };

                const closePortal = () => {
                    portal.hidden = true;
                    activeInput = null;
                    setPortalError("");
                };

                const renderList = entries => {
                    list.innerHTML = "";
                    emptyLabel.hidden = Array.isArray(entries) && entries.length > 0;

                    for (const entry of entries ?? []) {
                        const item = document.createElement("li");
                        const button = document.createElement("button");
                        button.type = "button";
                        button.className = "portal-row";
                        button.innerHTML = entry.isDirectory
                            ? `<span class="mono">${entry.path}</span><span>Open</span>`
                            : `<span class="mono">${entry.path}</span><span>Select</span>`;
                        button.addEventListener("click", async () => {
                            if (entry.isDirectory) {
                                await loadEntries(entry.path);
                                return;
                            }

                            if (activeInput) {
                                activeInput.value = entry.path;
                            }

                            closePortal();
                        });
                        item.appendChild(button);
                        list.appendChild(item);
                    }
                };

                const loadRoots = async () => {
                    setPortalError("");
                    setPortalPath("");
                    list.innerHTML = "";
                    emptyLabel.hidden = true;

                    try {
                        const response = await fetch("/api/filesystem/roots", { cache: "no-store" });
                        if (!response.ok) {
                            setPortalError("Unable to load filesystem roots.");
                            return;
                        }

                        const roots = await response.json();
                        renderList((roots ?? []).map(entry => ({ ...entry, isDirectory: true })));
                    } catch {
                        setPortalError("Unable to load filesystem roots.");
                    }
                };

                const loadEntries = async path => {
                    setPortalError("");
                    setPortalPath(path);
                    list.innerHTML = "";
                    emptyLabel.hidden = true;

                    try {
                        const response = await fetch(`/api/filesystem/entries?path=${encodeURIComponent(path)}&includeFiles=true&searchPattern=${encodeURIComponent("*.exe")}`, {
                            cache: "no-store"
                        });

                        if (!response.ok) {
                            const payload = await response.json().catch(() => null);
                            setPortalError(payload?.error ?? "Unable to load folders and executables.");
                            return;
                        }

                        const entries = await response.json();
                        renderList(entries);
                    } catch {
                        setPortalError("Unable to load folders and executables.");
                    }
                };

                document.querySelectorAll("[data-file-picker='true']").forEach(input => {
                    const button = input.parentElement?.querySelector("[data-file-picker-button='true']");
                    const status = input.parentElement?.parentElement?.querySelector("[data-file-picker-status='true']");
                    if (!(input instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement)) {
                        return;
                    }

                    const setStatus = (message, isError) => {
                        if (!(status instanceof HTMLParagraphElement)) {
                            return;
                        }

                        if (!message) {
                            status.hidden = true;
                            status.textContent = "";
                            status.classList.remove("error");
                            return;
                        }

                        status.hidden = false;
                        status.textContent = message;
                        status.classList.toggle("error", !!isError);
                    };

                    button.addEventListener("click", async () => {
                        setStatus("", false);
                        activeInput = input;
                        portal.hidden = false;

                        const initialPath = input.value.trim();
                        if (initialPath) {
                            const parentPath = getParentPath(initialPath);
                            await loadEntries(parentPath || initialPath);
                        } else {
                            await loadRoots();
                        }
                    });
                });

                rootsButton.addEventListener("click", loadRoots);
                upButton.addEventListener("click", async () => {
                    const parentPath = getParentPath(currentPath);
                    if (parentPath) {
                        await loadEntries(parentPath);
                        return;
                    }

                    await loadRoots();
                });
                closeButton.addEventListener("click", closePortal);
                portal.addEventListener("click", event => {
                    if (event.target === portal) {
                        closePortal();
                    }
                });
            };

            const initTwitchLoginAutocomplete = () => {
                document.querySelectorAll("[data-twitch-login-autocomplete='true']").forEach(input => {
                    if (!(input instanceof HTMLInputElement)) {
                        return;
                    }

                    const minLength = Number.parseInt(input.dataset.twitchLoginMinLength ?? "4", 10);
                    const suggestions = input.parentElement?.querySelector("[data-twitch-login-suggestions='true']");
                    if (!(suggestions instanceof HTMLUListElement)) {
                        return;
                    }

                    let requestId = 0;

                    const clearSuggestions = () => {
                        suggestions.innerHTML = "";
                        suggestions.hidden = true;
                    };

                    const renderSuggestions = results => {
                        suggestions.innerHTML = "";
                        if (!Array.isArray(results) || results.length === 0) {
                            suggestions.hidden = true;
                            return;
                        }

                        for (const result of results) {
                            const item = document.createElement("li");
                            const button = document.createElement("button");
                            button.type = "button";
                            button.className = "autocomplete-option";
                            button.innerHTML =
                                `<div class="autocomplete-primary"><span>${result.displayName}</span><span class="mono">${result.login}</span></div>` +
                                `<div class="autocomplete-secondary">${result.isLive ? "Live now" : "Offline"}</div>`;
                            button.addEventListener("click", () => {
                                input.value = result.login ?? "";
                                clearSuggestions();
                                input.focus();
                            });
                            item.appendChild(button);
                            suggestions.appendChild(item);
                        }

                        suggestions.hidden = false;
                    };

                    input.addEventListener("input", async () => {
                        const query = input.value.trim();
                        if (query.length < minLength) {
                            clearSuggestions();
                            return;
                        }

                        const currentRequestId = ++requestId;
                        try {
                            const response = await fetch(`/api/twitch/channels/search?query=${encodeURIComponent(query)}`, {
                                cache: "no-store"
                            });

                            if (!response.ok) {
                                clearSuggestions();
                                return;
                            }

                            const results = await response.json();
                            if (currentRequestId !== requestId) {
                                return;
                            }

                            renderSuggestions(results);
                        } catch {
                            clearSuggestions();
                        }
                    });

                    input.addEventListener("blur", () => {
                        window.setTimeout(clearSuggestions, 150);
                    });
                });
            };

            initDirectoryPickers();
            initFilePickers();
            initTwitchLoginAutocomplete();
            initAutoRefresh();
        })();
    </script>
</body>
</html>
