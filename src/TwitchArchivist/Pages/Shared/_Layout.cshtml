<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TwitchArchivist</title>
    <style>
        :root {
            color-scheme: dark;
            font-family: "Segoe UI", sans-serif;
            --bg: #07111f;
            --bg-elevated: #0f1b2d;
            --bg-panel: rgba(15, 27, 45, 0.92);
            --bg-panel-strong: #132238;
            --border: rgba(148, 163, 184, 0.18);
            --border-strong: rgba(96, 165, 250, 0.24);
            --text: #e5eefb;
            --text-muted: #94a3b8;
            --accent: #60a5fa;
            --accent-strong: #3b82f6;
            --accent-soft: rgba(96, 165, 250, 0.16);
            --success-soft: rgba(34, 197, 94, 0.16);
            --success-text: #86efac;
            --warn-soft: rgba(245, 158, 11, 0.18);
            --warn-text: #fcd34d;
            --danger-text: #fca5a5;
            --shadow: 0 18px 50px rgba(2, 6, 23, 0.45);
        }

        body {
            margin: 0;
            min-height: 100vh;
            background:
                radial-gradient(circle at top left, rgba(59, 130, 246, 0.16), transparent 30%),
                radial-gradient(circle at top right, rgba(14, 165, 233, 0.10), transparent 28%),
                linear-gradient(180deg, #08101d 0%, #07111f 48%, #050b15 100%);
            color: var(--text);
        }

        header {
            background: linear-gradient(135deg, rgba(37, 99, 235, 0.92), rgba(15, 23, 42, 0.98));
            color: white;
            padding: 1rem 1.5rem 1.15rem;
            border-bottom: 1px solid rgba(148, 163, 184, 0.14);
            box-shadow: 0 12px 40px rgba(2, 6, 23, 0.35);
        }

        header h1 {
            margin: 0 0 0.75rem;
            font-size: 1.5rem;
            letter-spacing: 0.01em;
        }

        nav a {
            color: #dbeafe;
            margin-right: 0.75rem;
            text-decoration: none;
            font-weight: 600;
            display: inline-block;
            padding: 0.5rem 0.8rem;
            border-radius: 999px;
            background: rgba(15, 23, 42, 0.24);
            border: 1px solid rgba(191, 219, 254, 0.12);
            transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
        }

        nav a:hover {
            background: rgba(96, 165, 250, 0.16);
            border-color: rgba(147, 197, 253, 0.22);
            color: white;
        }

        main {
            max-width: 1100px;
            margin: 0 auto;
            padding: 1.75rem 1.5rem 2rem;
        }

        .panel {
            background: linear-gradient(180deg, var(--bg-panel) 0%, rgba(11, 19, 33, 0.96) 100%);
            border: 1px solid var(--border);
            border-radius: 1rem;
            padding: 1rem 1.25rem;
            box-shadow: var(--shadow);
            margin-bottom: 1rem;
            backdrop-filter: blur(12px);
        }

        h1, h2, h3 {
            color: #f8fbff;
        }

        a {
            color: #93c5fd;
        }

        a:hover {
            color: #bfdbfe;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: rgba(8, 15, 28, 0.45);
            border-radius: 0.8rem;
            overflow: hidden;
        }

        th, td {
            text-align: left;
            padding: 0.65rem 0.5rem;
            border-bottom: 1px solid var(--border);
            vertical-align: top;
        }

        th {
            color: #cbd5e1;
            font-size: 0.92rem;
            font-weight: 700;
            background: rgba(15, 23, 42, 0.42);
        }

        .grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        }

        .metric {
            font-size: 1.75rem;
            font-weight: 700;
            margin-top: 0.5rem;
            color: #f8fbff;
        }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 0.25rem;
            color: #dbe7f5;
        }

        input[type=text], input[type=password], input[type=number] {
            width: 100%;
            padding: 0.65rem 0.75rem;
            border-radius: 0.5rem;
            border: 1px solid var(--border-strong);
            box-sizing: border-box;
            background: var(--bg-elevated);
            color: var(--text);
        }

        input[type=text]:focus, input[type=password]:focus, input[type=number]:focus {
            outline: 2px solid rgba(96, 165, 250, 0.35);
            outline-offset: 1px;
            border-color: rgba(147, 197, 253, 0.45);
        }

        .form-grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        }

        .actions {
            margin-top: 1rem;
            display: flex;
            gap: 0.75rem;
        }

        button, .button-link {
            background: linear-gradient(135deg, var(--accent-strong), #2563eb);
            color: white;
            border: 0;
            border-radius: 0.5rem;
            padding: 0.7rem 1rem;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            font-weight: 700;
            box-shadow: 0 10px 24px rgba(37, 99, 235, 0.28);
        }

        button:hover, .button-link:hover {
            background: linear-gradient(135deg, #60a5fa, #3b82f6);
            color: white;
        }

        .muted {
            color: var(--text-muted);
        }

        .badge {
            display: inline-block;
            border-radius: 999px;
            padding: 0.2rem 0.6rem;
            font-size: 0.85rem;
            font-weight: 600;
            background: var(--success-soft);
            color: var(--success-text);
            border: 1px solid rgba(34, 197, 94, 0.18);
        }

        .badge.warn {
            background: var(--warn-soft);
            color: var(--warn-text);
            border: 1px solid rgba(245, 158, 11, 0.18);
        }

        .validation-summary-errors {
            color: var(--danger-text);
            margin-bottom: 1rem;
        }

        @@media (max-width: 720px) {
            nav a {
                margin-bottom: 0.5rem;
            }
        }
    </style>
</head>
<body>
    <header>
        <h1>Twitch Archivist</h1>
        <nav>
            <a asp-page="/Index">Dashboard</a>
            <a asp-page="/Channels/Index">Channels</a>
            <a asp-page="/Jobs/Index">Jobs</a>
            <a asp-page="/Diagnostics/Index">Diagnostics</a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
