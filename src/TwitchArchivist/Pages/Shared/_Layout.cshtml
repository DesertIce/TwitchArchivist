<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TwitchArchivist</title>
    <style>
        :root {
            color-scheme: light;
            font-family: "Segoe UI", sans-serif;
        }

        body {
            margin: 0;
            background: #f5f7fb;
            color: #1b2430;
        }

        header {
            background: linear-gradient(135deg, #4f46e5, #0f172a);
            color: white;
            padding: 1rem 1.5rem;
        }

        nav a {
            color: white;
            margin-right: 1rem;
            text-decoration: none;
            font-weight: 600;
        }

        main {
            max-width: 1100px;
            margin: 0 auto;
            padding: 1.5rem;
        }

        .panel {
            background: white;
            border-radius: 0.75rem;
            padding: 1rem 1.25rem;
            box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
            margin-bottom: 1rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            text-align: left;
            padding: 0.65rem 0.5rem;
            border-bottom: 1px solid #e5e7eb;
            vertical-align: top;
        }

        .grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        }

        .metric {
            font-size: 1.75rem;
            font-weight: 700;
            margin-top: 0.5rem;
        }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 0.25rem;
        }

        input[type=text], input[type=password], input[type=number] {
            width: 100%;
            padding: 0.65rem 0.75rem;
            border-radius: 0.5rem;
            border: 1px solid #cbd5e1;
            box-sizing: border-box;
        }

        .form-grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        }

        .actions {
            margin-top: 1rem;
            display: flex;
            gap: 0.75rem;
        }

        button, .button-link {
            background: #1d4ed8;
            color: white;
            border: 0;
            border-radius: 0.5rem;
            padding: 0.7rem 1rem;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }

        .muted {
            color: #64748b;
        }

        .badge {
            display: inline-block;
            border-radius: 999px;
            padding: 0.2rem 0.6rem;
            font-size: 0.85rem;
            font-weight: 600;
            background: #dbeafe;
            color: #1d4ed8;
        }

        .badge.warn {
            background: #fef3c7;
            color: #92400e;
        }

        .validation-summary-errors {
            color: #b91c1c;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <header>
        <h1>TwitchArchivist</h1>
        <nav>
            <a asp-page="/Index">Dashboard</a>
            <a asp-page="/Channels/Index">Channels</a>
            <a asp-page="/Jobs/Index">Jobs</a>
            <a asp-page="/Diagnostics/Index">Diagnostics</a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
