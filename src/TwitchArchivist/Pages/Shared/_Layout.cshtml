@{
    var currentPage = (ViewContext.RouteData.Values["page"] as string ?? string.Empty);
    string NavClass(string pagePath) =>
        currentPage.StartsWith(pagePath, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TwitchArchivist</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23132238'/%3E%3Cpath d='M14 14h36v22l-8 8h-8l-6 6v-6h-14V14z' fill='%2360a5fa'/%3E%3Crect x='28' y='22' width='4' height='12' fill='%23132238'/%3E%3Crect x='38' y='22' width='4' height='12' fill='%23132238'/%3E%3C/svg%3E" />
    <style>
        :root {
            color-scheme: dark;
            font-family: "Segoe UI", sans-serif;
            --bg: #05080d;
            --bg-elevated: #0b1018;
            --bg-panel: #0a0f17;
            --bg-panel-strong: #0e1420;
            --bg-row: #070a11;
            --border: rgba(148, 163, 184, 0.12);
            --border-strong: rgba(96, 165, 250, 0.22);
            --text: #e5eefb;
            --text-muted: #94a3b8;
            --accent: #60a5fa;
            --accent-strong: #3b82f6;
            --accent-soft: rgba(96, 165, 250, 0.14);
            --success-soft: rgba(34, 197, 94, 0.14);
            --success-text: #86efac;
            --warn-soft: rgba(245, 158, 11, 0.14);
            --warn-text: #fcd34d;
            --danger-soft: rgba(239, 68, 68, 0.14);
            --danger-text: #fca5a5;
            --info-soft: rgba(96, 165, 250, 0.14);
            --info-text: #bfdbfe;
            --neutral-soft: rgba(148, 163, 184, 0.12);
            --neutral-text: #cbd5e1;
            --shadow: 0 18px 50px rgba(0, 0, 0, 0.55);
            --mono-font: ui-monospace, "Cascadia Mono", "Consolas", "SFMono-Regular", "Menlo", monospace;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: var(--bg);
            color: var(--text);
        }

        header {
            background: #070b12;
            color: var(--text);
            padding: 0.85rem 1.5rem 0.95rem;
            border-bottom: 1px solid var(--border);
        }

        .header-row {
            display: flex;
            align-items: center;
            gap: 1.25rem;
            flex-wrap: wrap;
        }

        header h1 {
            margin: 0;
            font-size: 1.25rem;
            letter-spacing: 0.01em;
            flex: 0 0 auto;
        }

        nav {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
        }

        nav a {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            display: inline-block;
            padding: 0.35rem 0.75rem;
            border-radius: 0.4rem;
            background: transparent;
            border: 1px solid transparent;
            transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
        }

        nav a:hover {
            background: rgba(255, 255, 255, 0.04);
            color: var(--text);
        }

        nav a.active {
            background: rgba(96, 165, 250, 0.10);
            border-color: var(--border-strong);
            color: var(--info-text);
        }

        main {
            max-width: 1100px;
            margin: 0 auto;
            padding: 1.5rem 1.5rem 2rem;
        }

        .panel {
            background: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: 0.85rem;
            padding: 1rem 1.25rem;
            box-shadow: 0 1px 0 rgba(255, 255, 255, 0.02) inset, 0 8px 24px rgba(0, 0, 0, 0.45);
            margin-bottom: 1rem;
        }

        h1, h2, h3 {
            color: #f8fbff;
        }

        a {
            color: #93c5fd;
        }

        a:hover {
            color: #bfdbfe;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: var(--bg-row);
            border-radius: 0.6rem;
            overflow: hidden;
            border: 1px solid var(--border);
        }

        th, td {
            text-align: left;
            padding: 0.65rem 0.65rem;
            border-bottom: 1px solid var(--border);
            vertical-align: top;
        }

        tbody tr:last-child td {
            border-bottom: 0;
        }

        tbody tr:nth-child(even) td {
            background: rgba(255, 255, 255, 0.015);
        }

        th {
            color: var(--text-muted);
            font-size: 0.82rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            background: #0c121b;
            border-bottom: 1px solid var(--border);
        }

        .grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        }

        .metric {
            font-size: 1.75rem;
            font-weight: 700;
            margin-top: 0.5rem;
            color: #f8fbff;
        }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 0.25rem;
            color: #dbe7f5;
        }

        input[type=text], input[type=password], input[type=number] {
            width: 100%;
            padding: 0.65rem 0.75rem;
            border-radius: 0.5rem;
            border: 1px solid var(--border-strong);
            box-sizing: border-box;
            background: #0d131c;
            color: var(--text);
        }

        input[type=text]:focus, input[type=password]:focus, input[type=number]:focus {
            outline: 2px solid rgba(96, 165, 250, 0.35);
            outline-offset: 1px;
            border-color: rgba(147, 197, 253, 0.45);
        }

        select {
            width: 100%;
            padding: 0.65rem 0.75rem;
            border-radius: 0.5rem;
            border: 1px solid var(--border-strong);
            box-sizing: border-box;
            background: #0d131c;
            color: var(--text);
        }

        .form-grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        }

        .field-hint {
            margin: 0.35rem 0 0;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .actions {
            margin-top: 1rem;
            display: flex;
            gap: 0.75rem;
        }

        .toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: end;
            justify-content: space-between;
            margin: 1rem 0 0.75rem;
        }

        .toolbar-group {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            align-items: end;
        }

        .panel-header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        button, .button-link {
            background: var(--accent-strong);
            color: white;
            border: 0;
            border-radius: 0.4rem;
            padding: 0.55rem 0.95rem;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            font-weight: 600;
            box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06) inset;
        }

        button:hover, .button-link:hover {
            background: var(--accent);
            color: white;
        }

        .button-ghost {
            background: transparent;
            color: #bfdbfe;
            border: 1px solid var(--border-strong);
            border-radius: 0.4rem;
            padding: 0.35rem 0.7rem;
            font-weight: 600;
            font-size: 0.88rem;
            box-shadow: none;
            text-decoration: none;
            display: inline-block;
            cursor: pointer;
        }

        .button-ghost:hover {
            background: var(--accent-soft);
            border-color: rgba(147, 197, 253, 0.45);
            color: white;
        }

        .button-danger {
            background: #991b1b;
            box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04) inset;
        }

        .button-danger:hover {
            background: #b91c1c;
        }

        .muted {
            color: var(--text-muted);
        }

        .mono {
            font-family: var(--mono-font);
            font-size: 0.92em;
        }

        .badge {
            display: inline-block;
            border-radius: 999px;
            padding: 0.2rem 0.6rem;
            font-size: 0.85rem;
            font-weight: 600;
            background: var(--success-soft);
            color: var(--success-text);
            border: 1px solid rgba(34, 197, 94, 0.18);
        }

        .badge.success {
            background: var(--success-soft);
            color: var(--success-text);
            border: 1px solid rgba(34, 197, 94, 0.18);
        }

        .badge.warn {
            background: var(--warn-soft);
            color: var(--warn-text);
            border: 1px solid rgba(245, 158, 11, 0.18);
        }

        .badge.danger {
            background: var(--danger-soft);
            color: var(--danger-text);
            border: 1px solid rgba(239, 68, 68, 0.2);
        }

        .badge.info {
            background: var(--info-soft);
            color: var(--info-text);
            border: 1px solid rgba(96, 165, 250, 0.22);
        }

        .badge.neutral {
            background: var(--neutral-soft);
            color: var(--neutral-text);
            border: 1px solid rgba(148, 163, 184, 0.22);
        }

        .level-pill {
            display: inline-block;
            border-radius: 0.25rem;
            padding: 0.05rem 0.4rem;
            font-family: var(--mono-font);
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        .level-pill.level-trace { background: transparent; color: #94a3b8; border: 1px solid var(--border); }
        .level-pill.level-debug { background: transparent; color: #cbd5e1; border: 1px solid var(--border); }
        .level-pill.level-information { background: transparent; color: var(--info-text); border: 1px solid rgba(96, 165, 250, 0.35); }
        .level-pill.level-warning { background: transparent; color: var(--warn-text); border: 1px solid rgba(245, 158, 11, 0.35); }
        .level-pill.level-error { background: rgba(239, 68, 68, 0.10); color: var(--danger-text); border: 1px solid rgba(239, 68, 68, 0.4); }
        .level-pill.level-critical { background: rgba(239, 68, 68, 0.22); color: #fee2e2; border: 1px solid rgba(239, 68, 68, 0.55); }

        .validation-summary-errors {
            color: var(--danger-text);
            margin-bottom: 1rem;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 1.1rem;
        }

        .field-validation-error {
            color: var(--danger-text);
            font-size: 0.85rem;
        }

        .log-text {
            margin: 0;
            white-space: pre-wrap;
            word-break: break-word;
            font: inherit;
        }

        .log-feed {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            margin-top: 0.75rem;
        }

        .log-entry {
            background: var(--bg-row);
            border: 1px solid var(--border);
            border-left: 3px solid var(--border);
            border-radius: 0.35rem;
            padding: 0.55rem 0.75rem 0.6rem;
        }

        .log-entry.level-information { border-left-color: rgba(96, 165, 250, 0.55); }
        .log-entry.level-warning { border-left-color: var(--warn-text); }
        .log-entry.level-error { border-left-color: var(--danger-text); }
        .log-entry.level-critical { border-left-color: #fee2e2; background: rgba(239, 68, 68, 0.05); }
        .log-entry.level-debug, .log-entry.level-trace { opacity: 0.85; }

        .log-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 0.55rem;
            align-items: baseline;
            font-size: 0.82rem;
            margin-bottom: 0.3rem;
        }

        .log-meta .log-time {
            color: var(--text-muted);
            font-family: var(--mono-font);
            white-space: nowrap;
        }

        .log-meta .log-cat {
            color: var(--info-text);
            font-family: var(--mono-font);
            word-break: break-all;
            opacity: 0.85;
        }

        .log-message {
            margin: 0;
            color: var(--text);
            white-space: pre-wrap;
            word-break: break-word;
            font-family: var(--mono-font);
            font-size: 0.9rem;
            line-height: 1.45;
        }

        .log-entry details.expandable {
            margin-top: 0.4rem;
            font-size: 0.85rem;
        }

        .log-entry details.expandable > summary {
            color: var(--text-muted);
        }

        .log-entry details.expandable[open] > summary {
            color: var(--danger-text);
        }

        .log-entry details.expandable pre {
            margin: 0.35rem 0 0;
            padding: 0.5rem 0.65rem;
            background: rgba(0, 0, 0, 0.35);
            border-radius: 0.35rem;
            border: 1px solid var(--border);
            font-family: var(--mono-font);
            font-size: 0.82rem;
            color: var(--danger-text);
        }

        details.expandable {
            cursor: pointer;
        }

        details.expandable > summary {
            list-style: none;
            color: #93c5fd;
            font-weight: 600;
        }

        details.expandable > summary::-webkit-details-marker {
            display: none;
        }

        details.expandable[open] > summary {
            margin-bottom: 0.4rem;
        }

        .kv-card {
            display: grid;
            grid-template-columns: minmax(11rem, max-content) 1fr;
            gap: 0.4rem 1rem;
            font-size: 0.95rem;
        }

        .kv-card dt {
            color: var(--text-muted);
            font-weight: 600;
            padding-top: 0.05rem;
        }

        .kv-card dd {
            margin: 0;
            color: var(--text);
            word-break: break-word;
        }

        .empty-state {
            text-align: center;
            padding: 1.75rem 1rem 2rem;
            color: var(--text-muted);
        }

        .empty-state h3 {
            margin: 0 0 0.5rem;
            color: var(--text);
        }

        .empty-state p {
            margin: 0 0 1rem;
        }

        .heartbeat {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .heartbeat::before {
            content: "";
            display: inline-block;
            width: 0.55rem;
            height: 0.55rem;
            border-radius: 50%;
            background: var(--success-text);
            box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.18);
            animation: heartbeat-pulse 2.4s ease-in-out infinite;
        }

        @@keyframes heartbeat-pulse {
            0%, 100% { opacity: 0.55; transform: scale(0.85); }
            50% { opacity: 1; transform: scale(1.05); }
        }

        @@media (max-width: 960px) {
            main { padding: 1.25rem 1rem 1.75rem; }
            .header-row { gap: 0.75rem; }
        }

        @@media (max-width: 720px) {
            header { padding: 0.85rem 1rem 0.95rem; }
            nav { width: 100%; }
        }
    </style>
</head>
<body>
    <header>
        <div class="header-row">
            <h1>Twitch Archivist</h1>
            <nav>
                <a class="@NavClass("/Index")" asp-page="/Index">Dashboard</a>
                <a class="@NavClass("/Channels")" asp-page="/Channels/Index">Channels</a>
                <a class="@NavClass("/Jobs")" asp-page="/Jobs/Index">Jobs</a>
                <a class="@NavClass("/Diagnostics")" asp-page="/Diagnostics/Index">Diagnostics</a>
                <a class="@NavClass("/Logs")" asp-page="/Logs/Index">Logs</a>
            </nav>
        </div>
    </header>
    <main>
        @RenderBody()
    </main>
    <script>
        (() => {
            const setText = (id, value, fallback = "") => {
                const element = document.getElementById(id);
                if (!element) {
                    return;
                }

                element.textContent = value ?? fallback;
            };

            const setBadgeClass = (id, badgeClass) => {
                const element = document.getElementById(id);
                if (!element) {
                    return;
                }

                element.classList.remove("success", "warn", "danger", "info", "neutral");
                if (badgeClass) {
                    element.classList.add(badgeClass);
                }
            };

            const eventSubBadgeClass = state => {
                switch (state) {
                    case "connected":
                    case "reconnected":
                        return "success";
                    case "connecting":
                    case "awaiting-authorization":
                        return "warn";
                    case "disconnected":
                    case "error":
                        return "danger";
                    case "not-configured":
                        return "neutral";
                    default:
                        return "neutral";
                }
            };

            const validityBadgeClass = validity => {
                if (validity === "valid") return "success";
                if (validity === "expiring-soon") return "warn";
                return "danger";
            };

            const formatRelative = isoUtc => {
                if (!isoUtc) return "";
                const then = Date.parse(isoUtc);
                if (Number.isNaN(then)) return "";
                const diffSec = Math.max(0, Math.round((Date.now() - then) / 1000));
                if (diffSec < 5) return "just now";
                if (diffSec < 60) return diffSec + "s ago";
                if (diffSec < 3600) return Math.round(diffSec / 60) + "m ago";
                return Math.round(diffSec / 3600) + "h ago";
            };

            let lastUpdatedUtc = null;

            const tickRelative = () => {
                const target = document.getElementById("runtime-relative");
                if (!target) return;
                target.textContent = lastUpdatedUtc ? "Updated " + formatRelative(lastUpdatedUtc) : "";
            };

            const renderRuntimeStatus = payload => {
                setText("runtime-diagnostics-message", payload.diagnosticsMessage ?? "");
                const eventSubState = payload.eventSubConnectionState ?? "";
                setText("runtime-eventsub-state", eventSubState);
                setBadgeClass("runtime-eventsub-state", eventSubBadgeClass(eventSubState));
                setText("runtime-twitch-configured", payload.twitchUserAuthorizationConfigured ? "Configured" : "Missing");
                const validity = payload.twitchUserAuthorizationValidity ?? "missing";
                setText("runtime-twitch-validity", validity);
                setBadgeClass("runtime-twitch-validity", validityBadgeClass(validity));
                setText("runtime-twitch-user", payload.twitchUserAuthorizationLogin ?? "Not authorized");
                setText("runtime-twitch-expires", payload.twitchUserAuthorizationExpiresUtc ?? "Not authorized");
                setText("runtime-twitch-last-validated", payload.twitchUserAuthorizationLastValidatedUtc ?? "Not validated");
                setText("runtime-twitch-detail", payload.twitchUserAuthorizationDetail ?? "");
                setText("runtime-updated-utc", payload.updatedUtc ?? "");
                if (payload.updatedUtc) {
                    lastUpdatedUtc = payload.updatedUtc;
                    tickRelative();
                }
            };

            const refreshRuntimeStatus = async () => {
                try {
                    const response = await fetch("/api/runtime-status", { cache: "no-store" });
                    if (!response.ok) {
                        return;
                    }

                    const payload = await response.json();
                    renderRuntimeStatus(payload);
                } catch {
                }
            };

            if (document.getElementById("runtime-twitch-validity") || document.getElementById("runtime-eventsub-state")) {
                refreshRuntimeStatus();
                window.setInterval(refreshRuntimeStatus, 15000);
                window.setInterval(tickRelative, 5000);
            }
        })();
    </script>
</body>
</html>
