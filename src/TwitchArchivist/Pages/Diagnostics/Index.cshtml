@page
@model TwitchArchivist.Pages.Diagnostics.IndexModel
@using TwitchArchivist.Pages
@{ ViewData["Title"] = "Diagnostics"; }

<div asp-validation-summary="ModelOnly"></div>

<section class="panel">
    <div class="panel-header-row">
        <h2>Service health</h2>
        <span class="heartbeat" id="runtime-relative"></span>
    </div>
    <dl class="kv-card">
        <dt>Database</dt>
        <dd><span class="badge @UiBadges.BoolBadgeClass(Model.RuntimeStatus.DatabaseReady)">@(Model.RuntimeStatus.DatabaseReady ? "Ready" : "Starting")</span></dd>

        <dt>Downloader executable</dt>
        <dd><span class="mono">@(Model.RuntimeStatus.DownloaderExecutablePath ?? "Not configured")</span></dd>

        <dt>Downloader valid</dt>
        <dd><span class="badge @UiBadges.BoolBadgeClass(Model.RuntimeStatus.DownloaderExecutableValid)">@(Model.RuntimeStatus.DownloaderExecutableValid ? "Yes" : "No")</span></dd>
    </dl>
</section>

<section class="panel">
    <h2>EventSub</h2>
    <dl class="kv-card">
        <dt>Connection state</dt>
        <dd><span class="badge @UiBadges.EventSubBadgeClass(Model.RuntimeStatus.EventSubConnectionState)" id="runtime-eventsub-state">@Model.RuntimeStatus.EventSubConnectionState</span></dd>

        <dt>Transport</dt>
        <dd><span class="mono" id="runtime-eventsub-transport">@Model.RuntimeStatus.EventSubTransportMode</span></dd>

        <dt>Conduit</dt>
        <dd><span class="mono" id="runtime-eventsub-conduit">@(Model.RuntimeStatus.EventSubConduitId ?? "Not assigned")</span></dd>

        <dt>Configured shards</dt>
        <dd><span class="mono" id="runtime-eventsub-configured-shards">@Model.RuntimeStatus.EventSubConfiguredShardCount</span></dd>

        <dt>Active shards</dt>
        <dd><span class="mono" id="runtime-eventsub-active-shards">@Model.RuntimeStatus.EventSubActiveShardCount</span></dd>

        <dt>Disabled shards</dt>
        <dd><span class="mono" id="runtime-eventsub-disabled-shards">@Model.RuntimeStatus.EventSubDisabledShardCount</span></dd>

        <dt>Last shard assignment error</dt>
        <dd id="runtime-eventsub-shard-error">@(Model.RuntimeStatus.EventSubLastShardAssignmentError ?? "None")</dd>

        <dt>Last subscription reconcile error</dt>
        <dd id="runtime-eventsub-reconcile-error">@(Model.RuntimeStatus.EventSubLastSubscriptionReconcileError ?? "None")</dd>

        <dt>Last rate limit</dt>
        <dd>
            @if (Model.RuntimeStatus.EventSubLastRateLimitUtc is { } rateLimitedUtc)
            {
                <span class="relative-time" data-utc="@rateLimitedUtc.ToString("u")" id="runtime-eventsub-rate-limit"></span>
                <span class="muted mono">(@rateLimitedUtc.ToString("u"))</span>
            }
            else
            {
                <span class="mono" id="runtime-eventsub-rate-limit">Never</span>
            }
        </dd>
    </dl>
</section>

<section class="panel">
    <h2>Downloader configuration</h2>
    <p class="muted">Save the full path to the `TwitchDownloaderCLI` executable here instead of editing `appsettings.json` manually.</p>

    @if (string.Equals(Model.SaveStatus, TwitchArchivist.Pages.Diagnostics.IndexModel.SaveStatusDownloaderSaved, StringComparison.Ordinal))
    {
        <p class="field-hint success">Downloader configuration saved.</p>
    }
    else if (string.Equals(Model.SaveStatus, TwitchArchivist.Pages.Diagnostics.IndexModel.SaveStatusDownloaderInstalled, StringComparison.Ordinal))
    {
        <p class="field-hint success">Managed TwitchDownloaderCLI installed and configured.</p>
    }

    <form method="post">
        <div>
            <label asp-for="Input.DownloaderExecutablePath"></label>
            <div class="input-with-button">
                <input asp-for="Input.DownloaderExecutablePath" class="mono" data-file-picker="true" />
                <button type="button" class="button-ghost" data-file-picker-button="true">Browse</button>
            </div>
            <p class="field-hint" data-file-picker-status="true" hidden></p>
            <span asp-validation-for="Input.DownloaderExecutablePath"></span>
            <p class="field-hint">Select the server-visible `TwitchDownloaderCLI.exe` file.</p>
        </div>
        <div class="actions">
            <button type="submit" asp-page-handler="InstallDownloader" class="button-ghost">Set up managed TwitchDownloaderCLI</button>
            <button type="submit" asp-page-handler="SaveDownloader">Save TwitchDownloaderCLI path</button>
        </div>
    </form>
    <p class="field-hint">The managed setup downloads the latest Windows x64 TwitchDownloaderCLI release into <span class="mono">tools\TwitchDownloaderCLI\current</span> under this app directory and updates the configured executable path automatically.</p>
</section>

<section class="panel">
    <h2>Twitch authorization</h2>
    <p class="muted">Create a Twitch application, save its client credentials here, then start user authorization from this page.</p>

    <ol class="steps-list">
        <li>Open the <a href="https://dev.twitch.tv/console" target="_blank" rel="noreferrer">Twitch developer console</a>.</li>
        <li>Create an application with an OAuth redirect URL that matches this running server exactly.</li>
        <li>Save the client id and client secret below, then run the Twitch authorization flow.</li>
    </ol>

    <div>
        <label for="twitch-callback-current">Callback URL for this running app</label>
        <div class="input-with-button">
            <input id="twitch-callback-current"
                   class="mono"
                   type="text"
                   value="@Model.TwitchOAuthCallbackUri"
                   readonly
                   data-copy-source="twitch-callback-current" />
            <button type="button" class="button-ghost" data-copy-button="true" data-copy-target="twitch-callback-current">Copy</button>
        </div>
    </div>

    @if (Model.ShowDevCallbackUrls)
    {
        <div class="form-grid">
            <div>
                <label for="twitch-callback-http-dev">Development HTTP callback</label>
                <div class="input-with-button">
                    <input id="twitch-callback-http-dev"
                           class="mono"
                           type="text"
                           value="http://localhost:5222/auth/twitch/callback"
                           readonly
                           data-copy-source="twitch-callback-http-dev" />
                    <button type="button" class="button-ghost" data-copy-button="true" data-copy-target="twitch-callback-http-dev">Copy</button>
                </div>
            </div>
            <div>
                <label for="twitch-callback-https-dev">Development HTTPS callback</label>
                <div class="input-with-button">
                    <input id="twitch-callback-https-dev"
                           class="mono"
                           type="text"
                           value="https://localhost:7153/auth/twitch/callback"
                           readonly
                           data-copy-source="twitch-callback-https-dev" />
                    <button type="button" class="button-ghost" data-copy-button="true" data-copy-target="twitch-callback-https-dev">Copy</button>
                </div>
            </div>
        </div>
    }

    @if (string.Equals(Model.SaveStatus, TwitchArchivist.Pages.Diagnostics.IndexModel.SaveStatusTwitchSaved, StringComparison.Ordinal))
    {
        <p class="field-hint success">Twitch application credentials saved.</p>
    }

    <form method="post">
        <div>
            <label asp-for="Input.TwitchClientId"></label>
            <input asp-for="Input.TwitchClientId" class="mono" autocomplete="off" />
            <span asp-validation-for="Input.TwitchClientId"></span>
        </div>
        <div>
            <label asp-for="Input.TwitchClientSecret"></label>
            <div class="password-toggle">
                <input asp-for="Input.TwitchClientSecret" class="mono" type="password" value="@Model.Input.TwitchClientSecret" autocomplete="off" spellcheck="false" />
                <button type="button" class="button-ghost" data-password-toggle="true" data-password-target="Input_TwitchClientSecret">Show</button>
            </div>
            <span asp-validation-for="Input.TwitchClientSecret"></span>
            <p class="field-hint">Generating a new Twitch client secret invalidates the old one.</p>
        </div>
        <div class="actions">
            <button type="submit" asp-page-handler="SaveTwitchApp">Save Twitch application credentials</button>
        </div>
    </form>

    <h3 class="panel-subhead">User authorization status</h3>
    <dl class="kv-card">
        <dt>Status</dt>
        <dd><span id="runtime-twitch-configured">@(Model.RuntimeStatus.TwitchUserAuthorizationConfigured ? "Configured" : "Missing")</span></dd>

        <dt>Validity</dt>
        <dd><span class="badge @Model.TwitchAuthorizationBadgeClass" id="runtime-twitch-validity">@Model.RuntimeStatus.TwitchUserAuthorizationValidity</span></dd>

        <dt>User</dt>
        <dd><span class="mono" id="runtime-twitch-user">@(Model.RuntimeStatus.TwitchUserAuthorizationLogin ?? "Not authorized")</span></dd>

        <dt>Expires</dt>
        <dd><span class="mono" id="runtime-twitch-expires">@(Model.RuntimeStatus.TwitchUserAuthorizationExpiresUtc?.ToString("u") ?? "Not authorized")</span></dd>

        <dt>Last validated</dt>
        <dd><span class="mono" id="runtime-twitch-last-validated">@(Model.RuntimeStatus.TwitchUserAuthorizationLastValidatedUtc?.ToString("u") ?? "Not validated")</span></dd>

        <dt>Detail</dt>
        <dd id="runtime-twitch-detail">@(Model.RuntimeStatus.TwitchUserAuthorizationDetail ?? "No Twitch user token is stored.")</dd>
    </dl>

    <p class="actions">
        <a class="button-link" href="/auth/twitch/start">Start or re-run Twitch authorization</a>
    </p>
</section>

<section class="panel">
    <h2>Diagnostics message</h2>
    <pre class="diagnostics-message mono" id="runtime-diagnostics-message">@(string.IsNullOrWhiteSpace(Model.RuntimeStatus.DiagnosticsMessage) ? "—" : Model.RuntimeStatus.DiagnosticsMessage)</pre>
    <p class="muted">Last updated <span class="mono" id="runtime-updated-utc">@Model.RuntimeStatus.UpdatedUtc.ToString("u")</span></p>
</section>
