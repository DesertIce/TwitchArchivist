@page
@model TwitchArchivist.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="panel">
    <h2>Unexpected error</h2>
    <p class="muted">The service encountered an unexpected request-processing error.</p>
    @if (!string.IsNullOrWhiteSpace(Model.RequestId))
    {
        <p>Request ID: <span class="mono">@Model.RequestId</span></p>
    }
    <p class="actions">
        <a class="button-link" asp-page="/Index">Back to dashboard</a>
    </p>
</section>
