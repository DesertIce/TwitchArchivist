@page
@model TwitchArchivist.Pages.IndexModel
@using TwitchArchivist.Pages
@{
    ViewData["Title"] = "Dashboard";
}

<section class="panel">
    <h2>Service overview</h2>
    <p class="muted">Local control surface for channel mappings, downloader configuration visibility, and archive job history.</p>
    <div class="grid">
        <div>
            <div class="muted">Configured channels</div>
            <div class="metric">@Model.ChannelCount</div>
        </div>
        <div>
            <div class="muted">Enabled channels</div>
            <div class="metric">@Model.EnabledChannelCount</div>
        </div>
        <div>
            <div class="muted">Archive jobs</div>
            <div class="metric">@Model.JobCount</div>
        </div>
        <div>
            <div class="muted">Database</div>
            <div class="metric">@(Model.RuntimeStatus.DatabaseReady ? "Ready" : "Starting")</div>
        </div>
    </div>
    <div class="heartbeat" id="runtime-relative"></div>
</section>

<section class="panel">
    <h2>Status</h2>
    <p><strong>Downloader:</strong> <span class="badge @(Model.RuntimeStatus.DownloaderExecutableValid ? "success" : "warn")">@Model.DownloaderStatusLabel</span></p>
    <p><strong>EventSub:</strong> <span class="badge @UiBadges.EventSubBadgeClass(Model.RuntimeStatus.EventSubConnectionState)" id="runtime-eventsub-state">@Model.RuntimeStatus.EventSubConnectionState</span></p>
    <p><strong>Twitch OAuth:</strong> <span class="badge @Model.TwitchAuthorizationBadgeClass" id="runtime-twitch-validity">@Model.TwitchAuthorizationStatusLabel</span></p>
    <p class="muted" id="runtime-twitch-detail">@Model.TwitchAuthorizationDetail</p>
    <p>
        <a class="button-link" href="/auth/twitch/start">Authorize Twitch</a>
        <a class="button-link button-ghost" asp-page="/Diagnostics/Index">Open diagnostics →</a>
    </p>
</section>

<section class="panel">
    <h2>Recent jobs</h2>
    @if (Model.RecentJobs.Count == 0)
    {
        <div class="empty-state">
            <h3>No jobs yet</h3>
            <p>Archive jobs will appear here once a configured channel goes live.</p>
        </div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Channel</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Output</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var job in Model.RecentJobs)
            {
                <tr>
                    <td>@job.ChannelConfiguration.TwitchLogin</td>
                    <td><span class="badge @UiBadges.JobStatusBadgeClass(job.Status)">@UiBadges.JobStatusLabel(job.Status)</span></td>
                    <td><span class="mono">@job.CreatedUtc.ToString("u")</span></td>
                    <td>
                        @if (job.OutputPath is null)
                        {
                            <text>-</text>
                        }
                        else
                        {
                            <span class="mono">@job.OutputPath</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
