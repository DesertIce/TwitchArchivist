@page
@model TwitchArchivist.Pages.Logs.IndexModel
@{
    ViewData["Title"] = "Logs";
}

<section class="panel" data-live-panel="logs">
    <h2>Recent logs</h2>
    <p class="muted">This buffer is in-memory only and is cleared on process restart.</p>

    <div class="toolbar">
        <form method="get" class="toolbar-group">
            <div>
                <label asp-for="MinimumLevel">Minimum level</label>
                <select asp-for="MinimumLevel" asp-items="Model.LevelOptions" data-auto-submit="true"></select>
            </div>
            <div>
                <label asp-for="Category">Category</label>
                <select asp-for="Category" data-auto-submit="true">
                    <option value="">All categories</option>
                    @foreach (var option in Model.CategoryOptions)
                    {
                        <option value="@option.Value" selected="@(string.Equals(option.Value, Model.Category, StringComparison.Ordinal))">@option.Text</option>
                    }
                </select>
            </div>
            <div>
                <label asp-for="Search">Search</label>
                <input asp-for="Search" type="search" placeholder="Match message or exception" autocomplete="off" />
            </div>
            <button type="submit">Apply filter</button>
            @if (Model.HasActiveFilter)
            {
                <a class="button-ghost" asp-page="/Logs/Index" asp-route-minimumLevel="@Model.MinimumLevel">Clear</a>
            }
        </form>

        <form method="post">
            <input type="hidden" asp-for="MinimumLevel" />
            <input type="hidden" asp-for="Category" />
            <input type="hidden" asp-for="Search" />
            <button type="submit" class="button-danger" onclick="return confirm('Clear all log entries from the in-memory buffer?');">Clear buffer</button>
        </form>
    </div>

    @if (Model.Entries.Count == 0)
    {
        <div class="empty-state">
            <h3>No matching log entries</h3>
            <p>Try lowering the minimum level, clearing filters, or wait for new activity.</p>
        </div>
    }
    else
    {
        <div class="log-feed">
            @foreach (var entry in Model.Entries)
            {
                var levelClass = "level-" + entry.Level.ToString().ToLowerInvariant();
                <article class="log-entry @levelClass">
                    <div class="log-meta">
                        <span class="level-pill @levelClass">@entry.Level</span>
                        <span class="log-time">@entry.TimestampUtc.ToString("u")</span>
                        <span class="log-cat">@entry.Category</span>
                    </div>
                    <pre class="log-message">@entry.Message</pre>
                    @if (!string.IsNullOrEmpty(entry.Exception))
                    {
                        <details class="expandable">
                            <summary>Show exception</summary>
                            <pre>@entry.Exception</pre>
                        </details>
                    }
                </article>
            }
        </div>
    }
</section>
