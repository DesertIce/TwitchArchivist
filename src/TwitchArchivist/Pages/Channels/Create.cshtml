@page
@model TwitchArchivist.Pages.Channels.CreateModel
@{
    ViewData["Title"] = "Add channel";
    ViewData["AutoRefreshEnabled"] = false;
}

<section class="panel">
    <p class="muted"><a asp-page="/Channels/Index">← Channels</a></p>
    <h2>Add channel mapping</h2>
    <p class="muted">The output directory should point at the root folder where completed VOD downloads will be written.</p>

    <div asp-validation-summary="ModelOnly"></div>

    <form method="post">
        <div class="form-grid">
            <div class="autocomplete-wrap" data-twitch-login-wrap="true">
                <label asp-for="Input.TwitchLogin"></label>
                <input asp-for="Input.TwitchLogin" autocomplete="off" spellcheck="false" data-twitch-login-autocomplete="true" data-twitch-login-min-length="4" />
                <ul class="autocomplete-list" data-twitch-login-suggestions="true" hidden></ul>
                <span asp-validation-for="Input.TwitchLogin"></span>
                <p class="field-hint">The lowercase Twitch username, without the URL or @@ symbol.</p>
            </div>
            <div>
                <label asp-for="Input.Alias"></label>
                <input asp-for="Input.Alias" />
                <span asp-validation-for="Input.Alias"></span>
                <p class="field-hint">Optional. Used instead of the Twitch login in generated filenames.</p>
            </div>
            <div>
                <label asp-for="Input.OutputDirectory"></label>
                <div class="input-with-button">
                    <input asp-for="Input.OutputDirectory" data-directory-picker="true" />
                    <button type="button" class="button-ghost" data-directory-picker-button="true">Browse</button>
                </div>
                <span asp-validation-for="Input.OutputDirectory"></span>
                <p class="field-hint">Absolute path to the folder where downloaded VODs will be stored. Example: <span class="mono">D:\twitch\archive\&lt;channel&gt;</span></p>
            </div>
            <div>
                <label class="label-inline">
                    <input asp-for="Input.AutoPruneEnabled" data-auto-prune-toggle="true" data-auto-prune-target="Input_AutoPruneVodCount" />
                    <span>@Html.DisplayNameFor(x => x.Input.AutoPruneEnabled)</span>
                </label>
                <p class="field-hint">Off by default. When enabled, the mapping will delete older successful VOD files after new downloads complete.</p>
            </div>
            <div>
                <label asp-for="Input.AutoPruneVodCount"></label>
                <input asp-for="Input.AutoPruneVodCount" type="number" min="1" />
                <span asp-validation-for="Input.AutoPruneVodCount"></span>
                <p class="field-hint">How many successful VOD files to keep for this mapping when auto prune is enabled.</p>
            </div>
        </div>
        <div class="actions">
            <button type="submit">Save channel</button>
            <a class="button-ghost" asp-page="/Channels/Index">Cancel</a>
        </div>
    </form>
</section>
