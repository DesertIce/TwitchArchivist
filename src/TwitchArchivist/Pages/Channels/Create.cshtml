@page
@model TwitchArchivist.Pages.Channels.CreateModel
@{
    ViewData["Title"] = "Add channel";
}

<section class="panel">
    <p class="muted"><a asp-page="/Channels/Index">← Channels</a></p>
    <h2>Add channel mapping</h2>
    <p class="muted">The output directory should point at the root folder where completed VOD downloads will be written.</p>

    <div asp-validation-summary="ModelOnly"></div>

    <form method="post">
        <div class="form-grid">
            <div>
                <label asp-for="Input.TwitchLogin"></label>
                <input asp-for="Input.TwitchLogin" />
                <span asp-validation-for="Input.TwitchLogin"></span>
                <p class="field-hint">The lowercase Twitch username, without the URL or @@ symbol.</p>
            </div>
            <div>
                <label asp-for="Input.OutputDirectory"></label>
                <input asp-for="Input.OutputDirectory" />
                <span asp-validation-for="Input.OutputDirectory"></span>
                <p class="field-hint">Absolute path to the folder where downloaded VODs will be stored. Example: <span class="mono">D:\twitch\archive\&lt;channel&gt;</span></p>
            </div>
        </div>
        <div class="actions">
            <button type="submit">Save channel</button>
            <a class="button-ghost" asp-page="/Channels/Index">Cancel</a>
        </div>
    </form>
</section>
