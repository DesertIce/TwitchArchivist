@page
@using TwitchArchivist.Pages
@model TwitchArchivist.Pages.Channels.IndexModel
@{
    ViewData["Title"] = "Channels";
}

<section class="panel">
    <div class="panel-header-row">
        <div>
            <h2>Channel mappings</h2>
            <p class="muted">Each configured channel maps to one archive output directory.</p>
        </div>
        <a class="button-link" asp-page="/Channels/Create">Add channel</a>
    </div>

    @if (Model.Channels.Count == 0)
    {
        <div class="empty-state">
            <h3>No channels configured yet</h3>
            <p>Add a Twitch channel to start archiving its broadcasts.</p>
            <a class="button-link" asp-page="/Channels/Create">Add your first channel</a>
        </div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Live</th>
                    <th>Twitch login</th>
                    <th>Output directory</th>
                    <th>Enabled</th>
                    <th>Last live</th>
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var channel in Model.Channels)
            {
                <tr>
                    <td><span class="badge @UiBadges.BoolBadgeClass(channel.IsLive)">@(channel.IsLive ? "Live" : "Offline")</span></td>
                    <td><span class="mono">@channel.TwitchLogin</span></td>
                    <td><span class="mono">@channel.OutputDirectory</span></td>
                    <td><span class="badge @UiBadges.BoolBadgeClass(channel.IsEnabled)">@(channel.IsEnabled ? "Yes" : "No")</span></td>
                    <td><span class="mono">@(channel.LastLiveUtc?.ToString("u") ?? "Never")</span></td>
                    <td><span class="mono">@channel.UpdatedUtc.ToString("u")</span></td>
                    <td><a class="button-ghost" asp-page="/Channels/Edit" asp-route-id="@channel.Id">Edit</a></td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
