{
  "Downloader": {
    "ExecutablePath": ""
  },
  "Twitch": {
    "UserAccessTokenRefreshBufferMinutes": 15,
    "EventSubMonitorIntervalSeconds": 15,
    "EventSubSubscriptionSyncIntervalSeconds": 60,
    "EventSubRetryBaseDelaySeconds": 5,
    "EventSubRetryMaxDelaySeconds": 60,
    "EventSubTransportMode": "websocket",
    "EventSubConduitShardCount": 4,
    "EventSubConduitId": null,
    "EventSubConduitAssignmentTimeoutSeconds": 10,
    "EventSubConduitReconcileIntervalSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "FileLogging": {
    "DirectoryPath": "logs",
    "FilePrefix": "twitcharchivist",
    "RetainedDayCount": 3
  }
}
